# ─── ORCA Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Comma-separated list of allowed frontend origins.
# In production: your Vercel/Netlify deployment URL(s).
# In dev: leave unset — defaults to http://localhost:5173,http://localhost:4173
# ALLOWED_ORIGINS=https://orca.vercel.app,https://orca-staging.vercel.app

# LLM backend (Ollama is default; swap for OpenAI-compatible endpoint if needed)
# OLLAMA_BASE_URL=http://localhost:11434

# Future: INCOIS API credentials (once official access is granted)
# INCOIS_API_KEY=
# MOSDAC_API_KEY=
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
