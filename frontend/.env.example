# ─── ORCA Frontend — Vite Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# Backend API base URL.
# In dev: leave unset — defaults to http://localhost:8000
# In production: set to your Cloud Run / Render / Railway backend URL
# VITE_API_BASE=https://orca-api-xxxxxxxx-uc.a.run.app
